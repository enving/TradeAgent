# Alpaca Paper Trading API
# Sign up at: https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# PostgreSQL Database
# Local: postgresql+asyncpg://user:password@localhost:5432/trade_agent
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trade_agent

# LLM Configuration (Flexible - supports multiple providers)
# The system auto-detects available providers in this priority:
# 1. IONOS (if configured)
# 2. OpenRouter (if configured)
# 3. Custom LLM_* variables

# IONOS Cloud AI (recommended if available)
IONOS_API_KEY=your_ionos_api_key_here
IONOS_API_URL=https://openai.inference.de-txl.ionos.com/v1
IONOS_MODEL=openai/gpt-oss-120b

# OpenRouter (alternative LLM provider)
# Sign up at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Custom LLM Configuration (optional - overrides IONOS/OpenRouter)
# LLM_API_KEY=your_custom_llm_key
# LLM_BASE_URL=https://your-llm-provider.com/v1
# LLM_MODEL=your-model-name

# News API Keys (Optional - for sentiment analysis)
# NewsAPI: https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# Finnhub: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_key_here

# Alpha Vantage: https://www.alphavantage.co/
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_LLM_FEATURES=true
